@@ -1613,10 +1616,39 @@ public class VideoPlayer implements Player.Listener, VideoListener, AnalyticsLis
 
 
     private boolean handleAudioFocus = false;
+    private boolean inu_hasAudioFocus = false;
+    private final AudioManager.OnAudioFocusChangeListener inu_audioFocusListener = focusChange -> {
+        if (focusChange == AudioManager.AUDIOFOCUS_LOSS || focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT) {
+            AndroidUtilities.runOnUIThread(this::pause);
+        }
+    };
+
+    private void inu_requestAudioFocus() {
+        if (handleAudioFocus && !inu_hasAudioFocus && !isMuted()) {
+            AudioManager am = (AudioManager) ApplicationLoader.applicationContext.getSystemService(Context.AUDIO_SERVICE);
+            if (am != null) {
+                int res = am.requestAudioFocus(inu_audioFocusListener, AudioManager.STREAM_MUSIC, AudioManager.AUDIOFOCUS_GAIN_TRANSIENT);
+                if (res == AudioManager.AUDIOFOCUS_REQUEST_GRANTED) {
+                    inu_hasAudioFocus = true;
+                }
+            }
+        }
+    }
+
+    private void inu_abandonAudioFocus() {
+        if (inu_hasAudioFocus) {
+            AudioManager am = (AudioManager) ApplicationLoader.applicationContext.getSystemService(Context.AUDIO_SERVICE);
+            if (am != null) {
+                am.abandonAudioFocus(inu_audioFocusListener);
+            }
+            inu_hasAudioFocus = false;
+        }
+    }
+
     public void handleAudioFocus(boolean handleAudioFocus) {
         this.handleAudioFocus = handleAudioFocus;
-        if (player != null) {
-            player.setAudioAttributes(player.getAudioAttributes(), handleAudioFocus);
+        if (!handleAudioFocus) {
+            inu_abandonAudioFocus();
         }
     }
 
@@ -1655,8 +1687,13 @@ public class VideoPlayer implements Player.Listener, VideoListener, AnalyticsLis
     @Override
     public void onPlayerStateChanged(boolean playWhenReady, int playbackState) {
         maybeReportPlayerState();
-        if (playWhenReady && playbackState == Player.STATE_READY && !isMuted() && shouldPauseOther) {
-            NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.playerDidStartPlaying, this);
+        if (playWhenReady && playbackState == Player.STATE_READY) {
